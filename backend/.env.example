PORT=3000
TIKTOK_USERNAME=your_tiktok_username

# Public URL of the site (CORS + Socket.IO). Same as domain on Plesk.
FRONTEND_URL=http://localhost:5173

# Optional: override CORS (comma-separated). Defaults to FRONTEND_URL.
# CORS_ORIGIN=https://meme.example.com,https://www.meme.example.com

# Serve frontend build from this folder (Plesk: copy frontend/dist → public)
# STATIC_DIR=./public

# Note: dùng tiktok-live-connector@2.0.9 (pin cứng).
# Bản 2.4+ bắt buộc Euler Stream trả phí → Connect sẽ 502.
