<?xml version="1.0" encoding="utf-8"?>
<!-- iisnode entry for Plesk Windows -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="app.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <!-- Let Node handle everything (API + Socket.IO + static via Express) -->
        <rule name="NodeApp" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <!-- Still route files through node when Express serves public -->
          <action type="Rewrite" url="app.js" />
        </rule>
        <rule name="NodeAll" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="app.js" />
        </rule>
      </rules>
    </rewrite>
    <iisnode
      nodeProcessCommandLine="node"
      watchedFiles="app.js;backend\dist\*;web.config"
      loggingEnabled="true"
      devErrorsEnabled="true"
      flushResponse="true"
    />
    <!-- WebSocket for Socket.IO -->
    <webSocket enabled="true" />
  </system.webServer>
</configuration>
